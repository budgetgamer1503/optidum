{
	"schemaVersion": 1,
	"id": "optidum",
	"version": "${version}",
	"name": "Optidum",
	"description": "Companion optimization mod for Sodium featuring entity AI throttling, smart chunk prioritization, Netty packet batching, and dynamic FPS",
	"authors": [
		"BudgetGamer1503"
	],
	"contact": {
		"homepage": "https://github.com/BudgetGamer1503/optidum",
		"sources": "https://github.com/BudgetGamer1503/optidum",
		"issues": "https://github.com/BudgetGamer1503/optidum/issues"
	},
	"license": "LGPL-3.0",
	"icon": "assets/optidum/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.budgetgamer1503.Optidum"
		],
		"client": [
			"com.budgetgamer1503.client.OptidumClient"
		],
		"sodium:config_api_user": [
			"com.budgetgamer1503.client.sodium.OptidumSodiumConfig"
		]
	},
	"mixins": [
		"optidum.mixins.json",
		{
			"config": "optidum.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"sodium": ">=0.8.0"
	},
	"suggests": {
		"dynamic_fps": "*",
		"titanium": "*",
		"modmenu": ">=9.0.0"
	},
	"custom": {
		"modmenu": {
			"parent": "sodium",
			"links": {
				"modmenu.discord": "https://discord.gg/ypPR9Tynqb"
			}
		}
	}
}